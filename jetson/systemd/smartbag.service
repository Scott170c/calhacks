# Start the SmartBag pipeline at boot.
#   sudo cp systemd/smartbag.service /etc/systemd/system/ && sudo systemctl enable --now smartbag
# Edit User, the ROS distro and the workspace path below to match the Jetson.
[Unit]
Description=SmartBag vision (2 cameras, YOLOv8, ROS 2)
After=network-online.target bluetooth.target nvargus-daemon.service
Wants=network-online.target

[Service]
User=jetson
Environment=ROS_DOMAIN_ID=42
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/jetson/smartbag/install/setup.bash && exec ros2 launch smartbag_vision smartbag.launch.py'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
